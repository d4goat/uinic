# Salin jadi .env.local lalu isi dari Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Hanya dipakai scripts/seed-demo.mjs (membuat akun demo). JANGAN commit nilainya.
SUPABASE_SERVICE_ROLE_KEY=
# Kata sandi akun demo. Tidak ada nilai bawaan di repo — repo ini publik.
DEMO_PASSWORD=

# Opsional, hanya untuk scripts/db-run.mjs (menjalankan SQL dari terminal).
# Pilih salah satu:
#   1) Personal Access Token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
#   2) Connection string Session pooler — Dashboard -> Connect (butuh `npm i -D pg`)
SUPABASE_DB_URL=
